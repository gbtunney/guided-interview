{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "rootDir": ".",
        "outDir": "./../dist",
        "declarationDir": "./../types",
        "types": ["node"]
    },
    "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
    "exclude": ["node_modules", "**/*.test.ts"]
}
